# {{ ansible_managed }}
[Unit]
Description={{ platform_name | upper }} — restore the latest backup and assert on it
Documentation=file://docs/runbooks/backup-restore.md
OnFailure=status-email@%n.service

[Service]
Type=oneshot
User=postgres
Group=postgres
# Restores into a throwaway cluster on a scratch port; never touches the live one.
ExecStart={{ app_base_dir }}/bin/verify_restore.sh --port 55432
TimeoutStartSec={{ rto_minutes * 60 }}
Nice=15
IOSchedulingClass=idle
StandardOutput=append:/var/log/{{ platform_name }}/backup-verify.log
StandardError=append:/var/log/{{ platform_name }}/backup-verify.log
