# {{ ansible_managed }}
[Unit]
Description={{ platform_name | upper }} — full PostgreSQL base backup
Documentation=file://docs/runbooks/backup-restore.md
After=postgresql-{{ postgresql_version }}.service
OnFailure=status-email@%n.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart={{ app_base_dir }}/bin/pg_backup.sh --mode full
TimeoutStartSec=14400
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
StandardOutput=append:/var/log/{{ platform_name }}/backup.log
StandardError=append:/var/log/{{ platform_name }}/backup.log
