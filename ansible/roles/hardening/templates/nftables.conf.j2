#!/usr/sbin/nft -f
# {{ ansible_managed }}
#
# Host firewall for {{ inventory_hostname }} ({{ group_names | difference(['all','platform']) | join(', ') }}).
# Default deny inbound; ports are opened only for the roles this host actually
# carries. The template is rendered per host and validated with `nft -c` before
# it is written, so a mistake here fails the play rather than the SSH session.

flush ruleset

define MGMT_NET      = { 10.{{ 10 if env_tier == 'dev' else (20 if env_tier == 'test' else (30 if env_tier == 'prod' else 40)) }}.1.0/24 }
define LB_NET        = { {% for h in groups['loadbalancers'] | default([]) %}{{ hostvars[h].ansible_host }}/32{% if not loop.last %}, {% endif %}{% endfor %} }
define APP_NET       = { {% for h in groups['appservers'] | default([]) + groups['tomcat_nodes'] | default([]) %}{{ hostvars[h].ansible_host }}/32{% if not loop.last %}, {% endif %}{% endfor %} }
define DB_NET        = { {% for h in groups['databases'] | default([]) %}{{ hostvars[h].ansible_host }}/32{% if not loop.last %}, {% endif %}{% endfor %} }
define MON_NET       = { {% for h in groups['monitoring'] | default([]) %}{{ hostvars[h].ansible_host }}/32{% if not loop.last %}, {% endif %}{% endfor %} }
define BACKUP_NET    = { {% for h in groups['backup'] | default([]) %}{{ hostvars[h].ansible_host }}/32{% if not loop.last %}, {% endif %}{% endfor %} }

table inet filter {

    # Rate-limit set for SSH brute force; fail2ban handles the long ban.
    set ssh_flood {
        type ipv4_addr
        flags dynamic, timeout
        timeout 1m
    }

    chain input {
        type filter hook input priority filter; policy drop;

        # Fast path for established traffic.
        ct state established,related accept
        ct state invalid drop comment "Drop packets that do not belong to a tracked flow"

        iif lo accept

        # ICMP: keep echo and the messages PMTU discovery depends on.
        ip protocol icmp icmp type { echo-request, echo-reply, destination-unreachable, time-exceeded, parameter-problem } limit rate 10/second accept
        ip6 nexthdr ipv6-icmp accept

        # --- Management ----------------------------------------------------
        ip saddr $MGMT_NET tcp dport {{ ssh_port }} ct state new \
            add @ssh_flood { ip saddr limit rate 6/minute burst 3 packets } accept \
            comment "SSH from the management network only"

{% if 'loadbalancers' in group_names %}
        # --- Edge: public service ports ------------------------------------
        tcp dport { 80, 443 } accept comment "HTTP/HTTPS service"
        ip saddr $LB_NET ip protocol vrrp accept comment "keepalived VRRP between LB peers"
{% endif %}

{% if 'appservers' in group_names %}
        # --- Spring Boot services: reachable from the edge only ------------
{% for svc in spring_services %}
        ip saddr $LB_NET tcp dport {{ svc.port }} accept comment "{{ svc.name }} service port"
        ip saddr $MON_NET tcp dport {{ svc.management_port }} accept comment "{{ svc.name }} actuator/metrics"
{% endfor %}
{% endif %}

{% if 'tomcat_nodes' in group_names %}
        # --- Tomcat / ZK UI tier -------------------------------------------
        ip saddr $LB_NET tcp dport {{ tomcat_http_port }} accept comment "Tomcat HTTP connector"
{% endif %}

{% if 'databases' in group_names %}
        # --- PostgreSQL ----------------------------------------------------
        ip saddr $APP_NET tcp dport {{ postgresql_port }} accept comment "Application connections"
        ip saddr $DB_NET  tcp dport {{ postgresql_port }} accept comment "Streaming replication between DB nodes"
        ip saddr $BACKUP_NET tcp dport {{ postgresql_port }} accept comment "Backup agent"
        ip saddr $MON_NET tcp dport 9187 accept comment "postgres_exporter"
{% endif %}

{% if 'monitoring' in group_names %}
        # --- Observability stack -------------------------------------------
        ip saddr $MGMT_NET tcp dport { 3000, 9090, 9093 } accept comment "Grafana, Prometheus, Alertmanager UIs"
        tcp dport 3100 ip saddr { $APP_NET, $DB_NET, $LB_NET } accept comment "Loki ingest from promtail"
{% endif %}

        # --- Metrics scraping: every host exposes node_exporter -------------
        ip saddr $MON_NET tcp dport {{ node_exporter_port }} accept comment "node_exporter"

        # --- Everything else ------------------------------------------------
        limit rate 5/minute log prefix "nft-drop-in: " level info
        counter drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        counter comment "This host is not a router"
    }

    chain output {
        type filter hook output priority filter; policy accept;
        ct state invalid drop
    }
}
