# {{ ansible_managed }}
# Environment for {{ item.name }} on {{ inventory_hostname }} ({{ env_tier }}).
# Secrets are injected from Ansible Vault — this file is mode 0640, group {{ app_group }}.

SPRING_PROFILES_ACTIVE={{ spring_profile }}
SPRING_CONFIG_ADDITIONAL_LOCATION=file:{{ app_base_dir }}/etc/{{ item.name }}-application.yml
SERVER_PORT={{ item.port }}
MANAGEMENT_SERVER_PORT={{ item.management_port }}

JAVA_OPTS=-Xms{{ item.heap }} -Xmx{{ item.heap }} \
 -XX:+Use{{ jvm_gc }}GC \
{% for opt in jvm_extra_opts %}
 {{ opt }} \
{% endfor %}
 -Xlog:gc*:file={{ app_log_dir }}/gc/{{ item.name }}-gc.log:time,uptime,level,tags:filecount=5,filesize=20M \
 -Dspring.application.name={{ item.name }} \
 -Dserver.tomcat.mbeanregistry.enabled=true \
 -Dcom.sun.management.jmxremote=false

# Database
DB_HOST={{ hostvars[groups['db_primary'][0]].ansible_host | default('127.0.0.1') }}
DB_PORT={{ postgresql_port }}
DB_NAME={{ platform_name }}
DB_USER={{ platform_name }}_app
DB_PASSWORD={{ vault_postgresql_app_password | default('changeme') }}

# Observability
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_METRICS_TAGS_ENVIRONMENT={{ env_tier }}
MANAGEMENT_METRICS_TAGS_INSTANCE={{ inventory_hostname }}
